# Copy to .env and fill in real values. Never commit .env.

# --- Database (Supabase Postgres) ---
# For serverless / Vercel, use the TRANSACTION pooler (port 6543) with
# pgbouncer=true. The pooler does NOT support prepared statements, which the app
# handles automatically (see src/db/index.ts). Example:
#   DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
#
# Alternatives (pick ONE for DATABASE_URL):
#   - Session pooler (long-running single server): ...pooler.supabase.com:5432
#   - Direct connection (full prepared-statement support, low conn ceiling):
#       postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Client-exposed Supabase (browser: storage uploads) ---
# Only publishable/anon values here — never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Session / Auth ---
# Strong (>=32 char) secret used to sign session cookies.
SESSION_SECRET=
# Proof-of-concept dev admin (replaced by DB users table in Phase 3).
DEV_ADMIN_PHONE=
# bcrypt hash of the dev PIN. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PIN', 12))"
DEV_ADMIN_PIN_HASH=

# --- Email (SMTP) for password-reset and transactional mail ---
# Works with any SMTP provider. Configured here for Brevo (smtp-relay.brevo.com).
# If unset, reset emails are logged to the server console instead of sent.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=bb9475001@smtp-brevo.com
# Set the Brevo SMTP key in your real .env / Vercel env — never commit it.
SMTP_PASS=
# Port 587 uses STARTTLS, so leave SMTP_SECURE blank/false.
SMTP_SECURE=
# From address — must be a Brevo-verified sender, e.g.
#   "Sahakar Bharati <no-reply@yourdomain.com>"
EMAIL_FROM=

# Public base URL used to build links in emails (e.g. password reset).
# No trailing slash. Example: https://app.yourdomain.com
APP_URL=

# --- Zoho Payments (DEPRECATED — not used, Sahakar Bharati is cash/udhar only) ---
# ZOHO_PAYMENTS_ACCOUNT_ID=
# ZOHO_PAYMENTS_CLIENT_ID=
# ZOHO_PAYMENTS_CLIENT_SECRET=
# ZOHO_PAYMENTS_API_KEY=
# ZOHO_PAYMENTS_DOMAIN=IN
