# Copy to .env and fill in real values. Never commit .env.

# --- Database (Supabase Postgres) ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Client-exposed Supabase (browser: storage uploads) ---
# Only publishable/anon values here — never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Session / Auth ---
# Strong (>=32 char) secret used to sign session cookies.
SESSION_SECRET=
# Proof-of-concept dev admin (replaced by DB users table in Phase 3).
DEV_ADMIN_PHONE=
# bcrypt hash of the dev PIN. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PIN', 12))"
DEV_ADMIN_PIN_HASH=

# --- Email (SMTP) for password-reset and transactional mail ---
# Works with any SMTP provider (SendGrid, AWS SES, Mailgun, Postmark, etc.).
# If unset, reset emails are logged to the server console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "true" for implicit TLS (usually port 465); otherwise leave blank/false.
SMTP_SECURE=
# From address, e.g. "Sahakar Bharati <no-reply@yourdomain.com>"
EMAIL_FROM=

# Public base URL used to build links in emails (e.g. password reset).
# No trailing slash. Example: https://app.yourdomain.com
APP_URL=

# --- Zoho Payments ---
ZOHO_PAYMENTS_ACCOUNT_ID=
ZOHO_PAYMENTS_CLIENT_ID=
ZOHO_PAYMENTS_CLIENT_SECRET=
ZOHO_PAYMENTS_API_KEY=
ZOHO_PAYMENTS_DOMAIN=IN
